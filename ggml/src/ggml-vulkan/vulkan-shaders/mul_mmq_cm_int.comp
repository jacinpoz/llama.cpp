// Int8 cooperative matrix matmul: quantized weights × Q8_1 activations → float output.
// RDNA3 gfx1100: 16×16×16 int8 coopmat, wave64 subgroup.
//
// Supported weight types (DATA_A_* define):
//   DATA_A_Q8_0   — direct int8 weights; no dequant in LDS needed
//   DATA_A_IQ4_XS — 4-bit symmetric quant; dequant to int8 via kvalues_iq4nl table in LDS
//   DATA_A_Q4_K   — 4-bit asymmetric quant; dequant to centered int8; needs activation-sum
//                   correction term for min offset (uses Q8_1 ds.y per BK block)
//
// Design: BM=64, BN=64 output tile per work group (4×4 = 16 coopmat tiles).
// Per K block: load A and B tiles to LDS → int32 coopMatMulAdd → coopMatStore to shmem_tmp
// → apply row×col scale → accumulate into float sums[].
// Scales are applied per K block (required since Q8_x/Q8_1 use block quantization).
//
// Buffer layout and push-constant fields identical to mul_mmq.comp.
// p.stride_a = ne10 = K (elements), same for all weight types.

#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable

#include "types.glsl"

// One work group = one subgroup (wave64 on RDNA3)
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout (constant_id = 0) const uint BLOCK_SIZE = 64;

// Fundamental coopmat tile dims (RDNA3 int8 coopmat: 16×16×16)
#define TM 16
#define TN 16
#define TK 16

// Work group output tile: 4×4 coopmat tiles = 64×64 elements
#define BM          64
#define BN          64
#define BK          32      // inner K step size; matches Q8_0 block size
#define cms_per_row 4       // = BM / TM
#define cms_per_col 4       // = BN / TN
#define NUM_TILES   16      // = cms_per_row * cms_per_col
// Elements per thread per tile at wave64: TM*TN/BLOCK_SIZE = 256/64 = 4
#define ELEMS_PER_TILE 4
#define TOTAL_ELEMS (NUM_TILES * ELEMS_PER_TILE)   // = 64 float sums per thread

// ── Buffer bindings ────────────────────────────────────────────────────────────
#if defined(DATA_A_Q8_0)
layout (binding = 0) readonly buffer A_PACKED16 { block_q8_0_packed16 data_a_packed16[]; };
#elif defined(DATA_A_IQ4_XS)
layout (binding = 0) readonly buffer A_IQ4XS    { block_iq4_xs_packed32 data_a_iq4xs[]; };
#elif defined(DATA_A_Q4_K)
layout (binding = 0) readonly buffer A_Q4K      { block_q4_K_packed32 data_a_q4k[]; };
#endif

layout (binding = 1) readonly buffer B { block_q8_1_x4_packed128 data_b[]; };
layout (binding = 2) writeonly buffer D { float data_d[]; };

// Push constants (= vk_mat_mat_push_constants, 17 × uint32 = 68 bytes)
// p.stride_a = ne10 = K (in elements, same for all types — divide by quant-block size in shader)
layout (push_constant) uniform parameter
{
    uint M;  uint N;  uint K;
    uint stride_a;  uint stride_b;  uint stride_d;
    uint batch_stride_a;  uint batch_stride_b;  uint batch_stride_d;
    uint base_work_group_z;  uint num_batches;  uint k_split;
    uint ne02;  uint ne12;  uint broadcast2;  uint broadcast3;
    uint padded_N;
} p;

// ── IQ4_XS lookup table ────────────────────────────────────────────────────────
// Pre-computed int8 dequant values for 4-bit nibble index 0..15.
// All values fit in int8 range [-128, 127].
#if defined(DATA_A_IQ4_XS)
const int8_t kvalues_iq4nl[16] = int8_t[16](
    int8_t(-127), int8_t(-104), int8_t(-83), int8_t(-65),
    int8_t(-49),  int8_t(-35),  int8_t(-22), int8_t(-10),
    int8_t(1),    int8_t(13),   int8_t(25),  int8_t(38),
    int8_t(53),   int8_t(69),   int8_t(89),  int8_t(113)
);
// IQ4_XS: 256 elements per super-block; BK=32 → 8 sub-blocks per super-block.
#define QUANT_K_IQ4XS 256u
#define SUB_PER_SUPER 8u
#endif

// ── Q4_K constants ─────────────────────────────────────────────────────────────
#if defined(DATA_A_Q4_K)
// Q4_K: 256 elements per super-block; 8 sub-blocks × 32 elements; BK=32 → 8 BK per super-block.
#define QUANT_K_Q4K   256u
#define SUB_PER_SUPER 8u
#endif

// ── Shared memory ──────────────────────────────────────────────────────────────
// Layout (base, all types):
//   shmem_a       [BM * BK]  = 2048 bytes  (row-major int8 weights)
//   shmem_b       [BN * BK]  = 2048 bytes  (col-major int8 activations)
//   shmem_scale_a [BM]       =  128 bytes  (float16 per A row, per K block)
//   shmem_scale_b [BN]       =  128 bytes  (float16 per B col, per K block)
//   shmem_tmp     [TM * TN]  = 1024 bytes  (one-tile int32 scratch, reused per tile)
// Base total: ~5.4 KB
//
// Q4_K additions (+256 bytes):
//   shmem_min_a   [BM]       =  128 bytes  (float16 dmin*mns per A row; min correction scale)
//   shmem_bsum    [BN]       =  128 bytes  (float16 Q8_1 ds.y = d_B*sum(qs_B) per B col)
shared int8_t    shmem_a[BM * BK];
shared int8_t    shmem_b[BN * BK];
shared float16_t shmem_scale_a[BM];
shared float16_t shmem_scale_b[BN];
shared int32_t   shmem_tmp[TM * TN];
#if defined(DATA_A_Q4_K)
shared float16_t shmem_min_a[BM];
shared float16_t shmem_bsum[BN];
#endif

void main() {
    const uint ic        = gl_WorkGroupID.y;
    const uint batch_idx = gl_WorkGroupID.z + p.base_work_group_z;

    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;
    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;
    const uint batch_idx_a = i03 * p.ne02 + i02;

    const uint blocks_m = (p.M + BM - 1u) / BM;
    const uint ir = gl_WorkGroupID.x % blocks_m;
    const uint ik = gl_WorkGroupID.x / blocks_m;

    const uint start_k = ik * p.k_split;
    const uint end_k   = min(p.K, (ik + 1u) * p.k_split);

    // ── A-matrix base position ─────────────────────────────────────────────────
    // p.stride_a = K (elements). Divide by quant-block size to get block index.
#if defined(DATA_A_Q8_0)
    // Q8_0: 32 elements per block. pos_a_ib is the base block index for row 0.
    uint pos_a_ib = batch_idx_a * (p.batch_stride_a / BK) +
                    (ir * BM * p.stride_a + start_k) / BK;
#elif defined(DATA_A_IQ4_XS)
    // IQ4_XS: 256 elements per super-block. pos_a_super is the super-block index for row 0.
    uint pos_a_super = batch_idx_a * (p.batch_stride_a / QUANT_K_IQ4XS) +
                       (ir * BM * p.stride_a + start_k) / QUANT_K_IQ4XS;
    // stride in super-blocks per A row (= K / 256)
    const uint stride_a_super = p.stride_a / QUANT_K_IQ4XS;
#elif defined(DATA_A_Q4_K)
    // Q4_K: 256 elements per super-block. pos_a_super is the super-block index for row 0.
    uint pos_a_super = batch_idx_a * (p.batch_stride_a / QUANT_K_Q4K) +
                       (ir * BM * p.stride_a + start_k) / QUANT_K_Q4K;
    // stride in super-blocks per A row (= K / 256)
    const uint stride_a_super = p.stride_a / QUANT_K_Q4K;
#endif

    // ── B-matrix base position ─────────────────────────────────────────────────
    // Q8_1: 32 elements per block. Same for all A types.
    uint pos_b_ib = (batch_idx * p.batch_stride_b +
                     ic * BN * p.stride_b + start_k) / BK;

    // Per-thread float accumulators: NUM_TILES tiles × ELEMS_PER_TILE elements.
    float sums[TOTAL_ELEMS];
    [[unroll]] for (uint i = 0u; i < TOTAL_ELEMS; i++) sums[i] = 0.0f;

    // Per-K-block int32 coopmat accumulators.
    coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> cm_c[NUM_TILES];
    coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cm_a[cms_per_row];
    coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> cm_b;

    for (uint block = start_k; block < end_k; block += BK) {

        // ── Load A tile ────────────────────────────────────────────────────────
        // BM*(BK/2) = 64*16 = 1024 int16-word loads; BLOCK_SIZE=64 → 16 words/thread.
#if defined(DATA_A_Q8_0)
        [[unroll]] for (uint i = gl_LocalInvocationIndex; i < BM * (BK / 2u); i += BLOCK_SIZE) {
            const uint row  = i / (BK / 2u);
            const uint word = i % (BK / 2u);
            const uint ib   = pos_a_ib + row * (p.stride_a / BK);
            const int16_t packed = data_a_packed16[ib].qs[word];
            shmem_a[row * BK + word * 2u    ] = int8_t(packed);
            shmem_a[row * BK + word * 2u + 1] = int8_t(packed >> 8);
            if (word == 0u) {
                shmem_scale_a[row] = data_a_packed16[ib].d;
            }
        }
#elif defined(DATA_A_IQ4_XS)
        // IQ4_XS: determine which sub-block within the 256-element super-block we're in.
        // sub_block ∈ [0..7], cycles every 8 BK steps.
        const uint sub_block = (block - start_k) / BK % SUB_PER_SUPER;

        // BM*(BK/2)=1024 pairs; each covers 2 nibbles from qs[]. BLOCK_SIZE=64 → 16 pairs/thread.
        [[unroll]] for (uint i = gl_LocalInvocationIndex; i < BM * (BK / 2u); i += BLOCK_SIZE) {
            const uint row      = i / (BK / 2u);         // A row index (0..BM-1)
            const uint pair_idx = i % (BK / 2u);         // byte index within sub-block (0..15)

            // Super-block for this A row
            const uint ib = pos_a_super + row * stride_a_super;

            // qs[] offset: each sub-block uses bytes [sub_block*16 .. sub_block*16+15].
            // block_iq4_xs_packed32.qs is uint32[32]; each uint32 holds 4 bytes = 8 nibbles.
            const uint byte_idx    = sub_block * 16u + pair_idx;
            const uint word_idx    = byte_idx / 4u;
            const uint byte_in_wrd = byte_idx % 4u;
            const uint qs_byte     = (data_a_iq4xs[ib].qs[word_idx] >> (byte_in_wrd * 8u)) & 0xFFu;

            shmem_a[row * BK + pair_idx * 2u    ] = kvalues_iq4nl[ qs_byte       & 0xFu];
            shmem_a[row * BK + pair_idx * 2u + 1] = kvalues_iq4nl[(qs_byte >> 4u) & 0xFu];

            if (pair_idx == 0u) {
                // Extract 6-bit sub-block scale for this row.
                // scales_l (uint32): 4 bits per sub-block, 2 sub-blocks per byte.
                //   byte = sub_block / 2, nibble = sub_block & 1
                const uint sl_byte = (data_a_iq4xs[ib].scales_l >> (8u * (sub_block / 2u))) & 0xFFu;
                const uint sl      = (sl_byte >> (4u * (sub_block & 1u))) & 0xFu;
                // scales_h (uint16): 2 bits per sub-block
                const uint sh      = (uint(data_a_iq4xs[ib].scales_h) >> (2u * sub_block)) & 3u;
                const int  scale6  = int(sl | (sh << 4u)) - 32;
                shmem_scale_a[row] = float16_t(float(data_a_iq4xs[ib].d) * float(scale6));
            }
        }
#elif defined(DATA_A_Q4_K)
        // Q4_K: determine which sub-block within the 256-element super-block we're in.
        // sub_block ∈ [0..7], cycles every 8 BK steps.
        const uint sub_block = (block - start_k) / BK % SUB_PER_SUPER;

        // Q4_K nibble layout: qs[32*(sb/2) + e] holds two nibbles:
        //   low  (shift=0): element e of even sub-blocks (sb=0,2,4,6)
        //   high (shift=4): element e of odd  sub-blocks (sb=1,3,5,7)
        // pair_idx covers 2 consecutive elements; both bytes are in the same uint32.
        const uint nibble_shift = (sub_block & 1u) * 4u;
        const uint qs_byte_base = 32u * (sub_block / 2u);

        [[unroll]] for (uint i = gl_LocalInvocationIndex; i < BM * (BK / 2u); i += BLOCK_SIZE) {
            const uint row      = i / (BK / 2u);
            const uint pair_idx = i % (BK / 2u);

            const uint ib = pos_a_super + row * stride_a_super;

            // Load 2 bytes from qs[] — pair_idx*2 and pair_idx*2+1.
            // Both bytes always fall in the same uint32 (pair_idx*2 is always even → offset 0 or 2).
            const uint byte0     = qs_byte_base + pair_idx * 2u;
            const uint word_idx  = byte0 / 4u;
            const uint byte_off  = (byte0 % 4u) * 8u;  // 0 or 16
            const uint word_val  = data_a_q4k[ib].qs[word_idx];
            const uint raw0      = (word_val >> byte_off) & 0xFFu;
            const uint raw1      = (word_val >> (byte_off + 8u)) & 0xFFu;

            // Centered int8: nibble ∈ [0..15] → int8 ∈ [-8..7]
            shmem_a[row * BK + pair_idx * 2u    ] = int8_t(int((raw0 >> nibble_shift) & 0xFu) - 8);
            shmem_a[row * BK + pair_idx * 2u + 1] = int8_t(int((raw1 >> nibble_shift) & 0xFu) - 8);

            if (pair_idx == 0u) {
                // Extract 6-bit scale (sc) and 6-bit min (mns) for this sub-block.
                // Encoding (from ggml-quants: scales[12] / uint32 scales[3]):
                //   if is < 4: sc = scales[is] & 0x3F, mns = scales[is+4] & 0x3F
                //   if is >= 4: sc = (scales[is+4]&0xF)|((scales[is-4]&0xC0)>>2)
                //               mns= (scales[is+4]>>4) |((scales[is]   &0xC0)>>2)
                const uint is = sub_block;
                uint sc, mns;
                if (is < 4u) {
                    // Helper: byte b from packed scales[3]
                    const uint b0 = (data_a_q4k[ib].scales[is / 4u]       >> ((is % 4u) * 8u)) & 0xFFu;
                    const uint b4 = (data_a_q4k[ib].scales[(is + 4u) / 4u] >> (((is + 4u) % 4u) * 8u)) & 0xFFu;
                    sc  = b0 & 0x3Fu;
                    mns = b4 & 0x3Fu;
                } else {
                    const uint is4 = is - 4u;
                    const uint bp4  = (data_a_q4k[ib].scales[(is + 4u) / 4u] >> (((is + 4u) % 4u) * 8u)) & 0xFFu;
                    const uint bim4 = (data_a_q4k[ib].scales[is4 / 4u]        >> ((is4 % 4u) * 8u)) & 0xFFu;
                    const uint bi   = (data_a_q4k[ib].scales[is / 4u]          >> ((is % 4u) * 8u)) & 0xFFu;
                    sc  = (bp4 & 0xFu) | ((bim4 & 0xC0u) >> 2u);
                    mns = (bp4 >> 4u)   | ((bi   & 0xC0u) >> 2u);
                }
                const float d    = float(data_a_q4k[ib].dm.x);
                const float dmin = float(data_a_q4k[ib].dm.y);
                shmem_scale_a[row] = float16_t(d    * float(sc));
                shmem_min_a[row]   = float16_t(dmin * float(mns));
            }
        }
#endif

        // ── Load B tile: BN cols of Q8_1 → shmem_b[BN*BK] (col-major int8) ──
        // BN*2 = 128 half-block iters; BLOCK_SIZE=64 → 2 iters/thread.
        [[unroll]] for (uint i = gl_LocalInvocationIndex; i < BN * 2u; i += BLOCK_SIZE) {
            const uint col      = i / 2u;
            const uint iqs      = i % 2u;
            const uint ib       = pos_b_ib + col * (p.stride_b / BK);
            const uint ib_outer = ib / 4u;
            const uint ib_inner = ib % 4u;
            if (iqs == 0u) {
                shmem_scale_b[col] = data_b[ib_outer].ds[ib_inner].x;
#if defined(DATA_A_Q4_K)
                // Q4_K needs the Q8_1 activation sum (ds.y = d_B * sum(qs_B)) for min correction.
                shmem_bsum[col] = data_b[ib_outer].ds[ib_inner].y;
#endif
            }
            const ivec4 vals = data_b[ib_outer].qs[ib_inner * 2u + iqs];
            const i8vec4 v0 = i8vec4(unpack8(uint(vals.x)));
            const i8vec4 v1 = i8vec4(unpack8(uint(vals.y)));
            const i8vec4 v2 = i8vec4(unpack8(uint(vals.z)));
            const i8vec4 v3 = i8vec4(unpack8(uint(vals.w)));
            const uint base = col * BK + iqs * 16u;
            shmem_b[base     ] = v0.x;  shmem_b[base +  1] = v0.y;
            shmem_b[base +  2] = v0.z;  shmem_b[base +  3] = v0.w;
            shmem_b[base +  4] = v1.x;  shmem_b[base +  5] = v1.y;
            shmem_b[base +  6] = v1.z;  shmem_b[base +  7] = v1.w;
            shmem_b[base +  8] = v2.x;  shmem_b[base +  9] = v2.y;
            shmem_b[base + 10] = v2.z;  shmem_b[base + 11] = v2.w;
            shmem_b[base + 12] = v3.x;  shmem_b[base + 13] = v3.y;
            shmem_b[base + 14] = v3.z;  shmem_b[base + 15] = v3.w;
        }

        barrier();

        // ── Int8 coopmat MulAdd: 2 TK passes × 4×4 tile grid ─────────────────
        [[unroll]] for (uint t = 0u; t < NUM_TILES; t++) {
            cm_c[t] = coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0);
        }

        [[unroll]] for (uint tk = 0u; tk < BK; tk += TK) {
            [[unroll]] for (uint i = 0u; i < cms_per_row; i++) {
                coopMatLoad(cm_a[i], shmem_a, i * TM * BK + tk, BK,
                            gl_CooperativeMatrixLayoutRowMajor);
            }
            [[unroll]] for (uint j = 0u; j < cms_per_col; j++) {
                coopMatLoad(cm_b, shmem_b, j * TN * BK + tk, BK,
                            gl_CooperativeMatrixLayoutColumnMajor);
                [[unroll]] for (uint i = 0u; i < cms_per_row; i++) {
                    cm_c[j * cms_per_row + i] =
                        coopMatMulAdd(cm_a[i], cm_b, cm_c[j * cms_per_row + i]);
                }
            }
        }

        // ── Per-tile coopMatStore → scale → float accumulate ─────────────────
        // shmem_tmp (TM*TN=1024 bytes) is reused per tile. Each thread reads only its
        // own elements (memoryBarrierShared() suffices — no full barrier needed).
        [[unroll]] for (uint t = 0u; t < NUM_TILES; t++) {
            const uint j = t / cms_per_row;   // tile col index (0..3)
            const uint i = t % cms_per_row;   // tile row index (0..3)
            coopMatStore(cm_c[t], shmem_tmp, 0u, TM,
                         gl_CooperativeMatrixLayoutColumnMajor);
            memoryBarrierShared();
            [[unroll]] for (uint e = 0u; e < ELEMS_PER_TILE; e++) {
                const uint f       = gl_LocalInvocationIndex * ELEMS_PER_TILE + e;
                const uint row     = f % TM;
                const uint col     = f / TM;
                const uint row_idx = i * TM + row;
                const uint col_idx = j * TN + col;
#if defined(DATA_A_Q8_0) || defined(DATA_A_IQ4_XS)
                const float scale = float(shmem_scale_a[row_idx]) *
                                    float(shmem_scale_b[col_idx]);
                sums[t * ELEMS_PER_TILE + e] += float(shmem_tmp[f]) * scale;
#elif defined(DATA_A_Q4_K)
                // Q4_K epilogue: coopmat result + min correction.
                // output = d_sc_a * d_b * dot(int8_q, b) + (8*d_sc_a - d_min_a) * (d_b*sum(b))
                // where: bsum = shmem_bsum[col_idx] = d_b * sum(qs_B)
                const float d_sc_a  = float(shmem_scale_a[row_idx]);
                const float d_min_a = float(shmem_min_a[row_idx]);
                const float d_b     = float(shmem_scale_b[col_idx]);
                const float bsum    = float(shmem_bsum[col_idx]);
                sums[t * ELEMS_PER_TILE + e] +=
                    float(shmem_tmp[f]) * d_sc_a * d_b
                    + (8.0f * d_sc_a - d_min_a) * bsum;
#endif
            }
        }
        // No trailing barrier() — the load barrier at the top of the next K block covers it.

        // ── Advance position counters ──────────────────────────────────────────
#if defined(DATA_A_Q8_0)
        pos_a_ib++;
#elif defined(DATA_A_IQ4_XS) || defined(DATA_A_Q4_K)
        // Advance super-block index every SUB_PER_SUPER=8 BK steps (= one 256-element block).
        if (sub_block == SUB_PER_SUPER - 1u) pos_a_super++;
#endif
        pos_b_ib++;
    }

    // ── Write float output ────────────────────────────────────────────────────
    const uint dr      = ir * BM;
    const uint dc      = ic * BN;
    const uint offsets = batch_idx * p.batch_stride_d +
                         ik * p.batch_stride_d * p.num_batches;

    [[unroll]] for (uint t = 0u; t < NUM_TILES; t++) {
        const uint j = t / cms_per_row;
        const uint i = t % cms_per_row;
        [[unroll]] for (uint e = 0u; e < ELEMS_PER_TILE; e++) {
            const uint f          = gl_LocalInvocationIndex * ELEMS_PER_TILE + e;
            const uint row        = f % TM;
            const uint col        = f / TM;
            const uint global_row = dr + i * TM + row;
            const uint global_col = dc + j * TN + col;
            if (global_row < p.M && global_col < p.N) {
                data_d[offsets + global_col * p.stride_d + global_row] =
                    sums[t * ELEMS_PER_TILE + e];
            }
        }
    }
}
